# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pocket
DATABASE_SSL=false

# Entra External ID (see docs/SETUP-AZURE.md)
AUTH_DISCOVERY_URL=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/v2.0/.well-known/openid-configuration
AUTH_AUDIENCE=<api-app-client-id>
AUTH_REQUIRED_SCOPE=access_as_user

# Azure OpenAI GPT-5 mini. Locally, `az login` is enough (DefaultAzureCredential).
AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Use AI_PROVIDER=dev for deterministic offline responses (refused in production).

AI_MONTHLY_CREDITS_FREE=150
AI_MONTHLY_CREDITS_PRO=1500

# Optional: delete the Entra identity on account deletion
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
