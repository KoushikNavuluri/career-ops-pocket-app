{
  "name": "@career-pocket/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "node src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/unit/*.test.ts\""
  },
  "dependencies": {
    "@azure/identity": "^4.10.0",
    "@azure/monitor-opentelemetry": "^1.11.0",
    "fastify": "^5.4.0",
    "jose": "^6.0.11",
    "openai": "^5.20.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.2"
  }
}
